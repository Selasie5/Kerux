# Public URL of the Kerux API, without a trailing slash.
NEXT_PUBLIC_API_URL=https://kerux-backend.onrender.com

# Add these from your Clerk dashboard when the app is ready to connect.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk's hosted route fallbacks used by the protected dashboard.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
